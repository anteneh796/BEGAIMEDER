APP_NAME="BEGAIMEDER ACADEMY CMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://admin.begaimederacademy.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stack
LOG_STACK=daily,stderr
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=
